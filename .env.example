# ---------------------------------------------------------------------------
# Bookshelf Exchange — environment (local dev). Copy to `.env`; never commit.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Host-side port is 5433; the container always listens on 5432 (PLAN §6).
DATABASE_URL="postgresql://bookshelf:bookshelf@localhost:5433/bookshelf_exchange?schema=public"

# Auth.js v5 ----------------------------------------------------------------
# Required in every environment. Generate with: npx auth secret
AUTH_SECRET="replace-with-a-generated-secret"
# AUTH_TRUST_HOST — v5 trusts the host in local dev. Only set this when the
# app sits behind a reverse proxy outside development.
# AUTH_TRUST_HOST="true"

# Google OAuth (optional, both-or-none) -------------------------------------
# Dispatch naming: AUTH_GOOGLE_* supersedes PLAN.md §4's GOOGLE_CLIENT_*.
# Authorized redirect URI: ${APP_URL}/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Images (M2) ---------------------------------------------------------------
IMAGE_STORE="local"
# The S3 image store lands in M2 (PLAN §7); its variables will be:
# S3_ENDPOINT="" S3_REGION="" S3_BUCKET="" S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY="" S3_PUBLIC_BASE_URL="" S3_FORCE_PATH_STYLE=""

# Prisma schema-engine mirror (Windows ECONNRESET fallback) ------------------
# If the schema engine download fails, uncomment both, delete node_modules,
# and reinstall fresh (never `--ignore-scripts`, never resume a failed install).
# PRISMA_ENGINES_MIRROR="https://registry.npmmirror.com/-/binary/prisma"
# PRISMA_BINARIES_MIRROR="https://registry.npmmirror.com/-/binary/prisma"

# Misc ----------------------------------------------------------------------
NODE_ENV="development"
# Default currency for new listings (M2; falls back to EGP).
# DEFAULT_CURRENCY="EGP"
