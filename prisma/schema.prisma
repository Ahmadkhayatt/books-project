// Bookshelf Exchange — Prisma v1 schema (PLAN.md §2).
// Prisma 7: datasource URL lives in prisma.config.ts; the client is generated
// to ../generated/prisma and imported via `@/generated/prisma/client`.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums (12)
// ---------------------------------------------------------------------------

enum Role {
  MEMBER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ListingType {
  SELL
  SWAP
  FREE
}

enum BookCondition {
  NEW
  LIKE_NEW
  GOOD
  ACCEPTABLE
  WORN
}

enum ListingStatus {
  ACTIVE
  RESERVED
  COMPLETED
  CANCELLED
}

enum ListVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum ActivityType {
  LISTING_CREATED
  LISTING_COMPLETED
  REVIEW_POSTED
  BOOK_SHELVED
  FOLLOWED_USER
  WISHLIST_ADDED
  EXCHANGE_COMPLETED
}

enum ExchangeStatus {
  PROPOSED
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum ReportTarget {
  USER
  LISTING
  REVIEW
  COMMENT
  MESSAGE
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  SCAM
  HARASSMENT
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReadingProgress {
  WANT
  READING
  READ
}

// ---------------------------------------------------------------------------
// Auth (canonical Auth.js models)
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  username      String     @unique
  passwordHash  String?
  role          Role       @default(MEMBER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts               Account[]
  sessions               Session[]
  profile                Profile?
  listings               Listing[]
  wishlistItems          WishlistItem[]
  ratings                Rating[]
  reviews                Review[]
  comments               Comment[]
  reviewLikes            ReviewLike[]
  commentLikes           CommentLike[]
  readingLists           ReadingList[]
  following              Follow[]                @relation("FollowerUser")
  followedBy             Follow[]                @relation("FollowingUser")
  activityEvents         ActivityEvent[]
  createdBooks           Book[]                  @relation("BookCreatedBy")
  conversations          ConversationParticipant[]
  messages               Message[]
  initiatedExchanges     Exchange[]              @relation("ExchangeInitiator")
  counterpartExchanges   Exchange[]              @relation("ExchangeCounterpart")
  exchangeRatingsGiven   ExchangeRating[]        @relation("ExchangeRatingRater")
  exchangeRatingsReceived ExchangeRating[]       @relation("ExchangeRatingRatedUser")
  reportsFiled           Report[]                @relation("ReportReporter")
  reportsResolved        Report[]                @relation("ReportResolver")
  adminActions           AdminAction[]

  @@index([status])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Profile & social
// ---------------------------------------------------------------------------

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String?
  bio             String?  @db.Text
  location        String?
  website         String?
  locale          String   @default("ar")
  reputationScore Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("FollowerUser", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowingUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@map("follows")
}

model ActivityEvent {
  id         String       @id @default(cuid())
  actorId    String
  type       ActivityType
  entityType String?
  entityId   String?
  createdAt  DateTime     @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("activity_events")
}

// ---------------------------------------------------------------------------
// Books catalog
// ---------------------------------------------------------------------------

model Book {
  id             String   @id @default(cuid())
  isbn13         String?  @unique
  isbn10         String?
  title          String
  titleAr        String?
  subtitle       String?
  description    String?  @db.Text
  publisher      String?
  publishedYear  Int?
  language       String   @default("ar")
  pageCount      Int?
  coverUrl       String?
  openLibraryKey String?  @unique
  subjects       String[] @default([])
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy        User?            @relation("BookCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  authors          BookAuthor[]
  listings         Listing[]
  wishlistItems    WishlistItem[]
  ratings          Rating[]
  reviews          Review[]
  comments         Comment[]
  readingListItems ReadingListItem[]

  @@index([title])
  @@map("books")
}

model Author {
  id             String   @id @default(cuid())
  name           String
  nameAr         String?
  openLibraryKey String?  @unique
  createdAt      DateTime @default(now())

  books BookAuthor[]

  @@index([name])
  @@map("authors")
}

model BookAuthor {
  id       String @id @default(cuid())
  bookId   String
  authorId String
  order    Int    @default(0)

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([bookId, authorId])
  @@index([authorId])
  @@map("book_authors")
}

// ---------------------------------------------------------------------------
// Listings & wishlist
// ---------------------------------------------------------------------------

model Listing {
  id            String         @id @default(cuid())
  bookId        String
  sellerId      String
  type          ListingType
  condition     BookCondition
  priceCents    Int?
  currency      String         @default("EGP")
  status        ListingStatus  @default(ACTIVE)
  description   String?        @db.Text
  images        String[]       @default([])
  location      String?
  meetupOptions String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  completedAt   DateTime?

  book          Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  exchange      Exchange?
  conversations Conversation[]

  @@index([bookId, status])
  @@index([sellerId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([type, status])
  @@map("listings")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Reviews & engagement
// ---------------------------------------------------------------------------

model Rating {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("ratings")
}

model Review {
  id              String   @id @default(cuid())
  userId          String
  bookId          String
  title           String?
  body            String   @db.Text
  containsSpoiler Boolean  @default(false)
  language        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    ReviewLike[]

  @@unique([userId, bookId])
  @@index([bookId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("reviews")
}

model Comment {
  id              String    @id @default(cuid())
  userId          String
  bookId          String
  reviewId        String?
  parentId        String?
  body            String    @db.Text
  containsSpoiler Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  review  Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  parent  Comment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentThread")
  likes   CommentLike[]

  @@index([bookId, createdAt])
  @@index([reviewId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model ReviewLike {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@map("review_likes")
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

// ---------------------------------------------------------------------------
// Reading lists
// ---------------------------------------------------------------------------

model ReadingList {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String?        @db.Text
  visibility  ListVisibility @default(PUBLIC)
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ReadingListItem[]

  @@index([userId])
  @@index([visibility, createdAt(sort: Desc)])
  @@map("reading_lists")
}

model ReadingListItem {
  id        String           @id @default(cuid())
  listId    String
  bookId    String
  note      String?
  order     Int              @default(0)
  progress  ReadingProgress  @default(WANT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  list ReadingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  book Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([listId, bookId])
  @@index([bookId])
  @@map("reading_list_items")
}

// ---------------------------------------------------------------------------
// Messaging & exchanges
// ---------------------------------------------------------------------------

model Conversation {
  id            String    @id @default(cuid())
  listingId     String?
  subject       String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  listing      Listing?                  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String   @db.Text
  attachments    String[] @default([])
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Exchange {
  id            String         @id @default(cuid())
  listingId     String         @unique
  initiatorId   String
  counterpartId String
  status        ExchangeStatus @default(PROPOSED)
  agreedTerms   String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  completedAt   DateTime?

  listing     Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  initiator   User             @relation("ExchangeInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  counterpart User             @relation("ExchangeCounterpart", fields: [counterpartId], references: [id], onDelete: Cascade)
  ratings     ExchangeRating[]

  @@index([initiatorId, status])
  @@index([counterpartId, status])
  @@index([status, updatedAt])
  @@map("exchanges")
}

model ExchangeRating {
  id          String   @id @default(cuid())
  exchangeId  String
  raterId     String
  ratedUserId String
  score       Int
  tags        String[] @default([])
  comment     String?
  createdAt   DateTime @default(now())

  exchange  Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  rater     User     @relation("ExchangeRatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  ratedUser User     @relation("ExchangeRatingRatedUser", fields: [ratedUserId], references: [id], onDelete: Cascade)

  @@unique([exchangeId, raterId])
  @@index([ratedUserId])
  @@map("exchange_ratings")
}

// ---------------------------------------------------------------------------
// Reports & admin
// ---------------------------------------------------------------------------

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetType   ReportTarget
  targetId     String
  reason       ReportReason
  details      String?      @db.Text
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolution   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  resolvedAt   DateTime?

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("reports")
}

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("admin_actions")
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_events")
}
